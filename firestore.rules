service cloud.firestore {
  match /databases/{database}/documents {

    // General guard – in all sub‑rules the user must be logged in
    match /{document=**} {
      allow read, write: if false;
    }

    // ---------- 1️⃣  Chat Requests (user can send, receiver can accept/reject) ---------
    match /chatRequests/{reqId} {
      // Sender creates a new request (must be the sender)
      allow create: if request.auth != null &&
                   request.auth.uid == request.resource.data.sender &&
                   request.resource.data.status == 'pending';

      // Receiver may update status to 'accepted' or 'rejected'
      allow update: if request.auth != null &&
                   request.auth.uid == resource.data.receiver &&
                   request.resource.data.status in ['accepted','rejected'] &&
                   // keep other fields unchanged
                   request.resource.data.sender == resource.data.sender &&
                   request.resource.data.receiver == resource.data.receiver;

      // The receiver can read their pending requests
      allow read: if request.auth != null &&
                  request.auth.uid == resource.data.receiver;

      // Neither party may delete the request (audit trail)
      allow delete: if false;
    }

    // ---------- 2️⃣  Conversations (one‑to‑one chat) ---------
    match /conversations/{convId} {
      // Only participants may read or write this conversation
      allow read, write: if request.auth != null &&
                          request.auth.uid in get(/databases/$(database)/documents/conversations/$(convId)).data.participants;

      // Creation is handled client‑side through addDoc creation of conversations/documents
      // Prevent exploit by wild‑creating docs
      allow create: if false;
      allow update, delete: if false;

      // ---------- 3️⃣  Messages sub‑collection ----------
      match /messages/{msgId} {
        // Only participants can read or write messages
        allow read, write: if request.auth != null &&
                            request.auth.uid in get(/databases/$(database)/documents/conversations/$(convId)).data.participants;
      }
    }
  }
}
