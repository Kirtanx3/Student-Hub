service cloud.firestore {
  match /databases/{database}/documents {

    // General guard – in all sub‑rules the user must be logged in
    match /{document=**} {
      allow read, write: if false;
    }

    // ---------- 0️⃣  Users Collection (profiles & student discovery) ----------
    match /users/{userId} {
      allow read: if request.auth != null;
      allow create, update: if request.auth != null && request.auth.uid == userId;
      allow delete: if false;
    }

    // ---------- 1️⃣  Chat Requests (user can send, receiver can accept/reject) ---------
    match /chatRequests/{reqId} {
      // Sender creates a request
      allow create: if request.auth != null &&
                   request.auth.uid == request.resource.data.sender &&
                   request.resource.data.status == 'pending';

      // Receiver may accept or reject
      allow update: if request.auth != null &&
                   request.auth.uid == resource.data.receiver &&
                   request.resource.data.status in ['accepted','rejected'] &&
                   request.resource.data.sender == resource.data.sender &&
                   request.resource.data.receiver == resource.data.receiver;

      // Receiver can read their pending requests
      allow read: if request.auth != null &&
                  request.auth.uid == resource.data.receiver;

      // Neither party may delete the request (audit trail)
      allow delete: if false;
    }

    // ---------- 2️⃣  Friend Requests (student‑to‑student) ----------
    match /friendRequests/{reqId} {
      allow read: if request.auth != null;
      allow create: if request.auth != null &&
                    request.auth.uid == request.resource.data.fromUid &&
                    request.resource.data.status == 'pending' &&
                    request.auth.uid != request.resource.data.toUid;
      allow update: if request.auth != null &&
                    (request.auth.uid == resource.data.toUid || request.auth.uid == resource.data.fromUid);
      allow delete: if request.auth != null &&
                    (request.auth.uid == resource.data.fromUid || request.auth.uid == resource.data.toUid);
    }

    // ---------- 3️⃣  Friendships (mutual friends) ----------
    match /friendships/{fsId} {
      allow read: if request.auth != null;
      allow create, update: if request.auth != null &&
                            request.auth.uid in request.resource.data.participants;
      allow delete: if request.auth != null &&
                    request.auth.uid in resource.data.participants;
    }

    // ---------- 4️⃣  Conversations (P2P Private Chat) ----------
    match /conversations/{convId} {
      allow read, write: if request.auth != null;

      // ---------- Sub‑collection: P2P Messages ----------
      match /messages/{msgId} {
        allow read, write: if request.auth != null;
      }
    }

    // ---------- 5️⃣  Global Messages & Typing ----------
    match /messages/{msgId} {
      allow read, create: if request.auth != null;
    }
    match /typing/{uid} {
      allow read, write: if request.auth != null;
    }

    // ---------- 6️⃣  Campus Lost & Found ----------
    match /lostAndFound/{itemId} {
      allow read: if request.auth != null;
      allow create: if request.auth != null &&
                    request.auth.uid == request.resource.data.reporterUid;
      allow update: if request.auth != null &&
                    (request.auth.uid == resource.data.reporterUid ||
                     request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status', 'resolvedAt', 'resolvedBy']));
      allow delete: if request.auth != null &&
                    request.auth.uid == resource.data.reporterUid;
    }

    // ---------- 7️⃣  Attendance Sessions & Check-ins ----------
    match /attendanceSessions/{sessionId} {
      allow read, write: if request.auth != null;
      match /checkins/{checkinId} {
        allow read, write: if request.auth != null;
      }
    }
  }
}
